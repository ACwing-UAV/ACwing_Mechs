# CAD lock, backup and temporary files
~$*
*.bak
*.BAK
*.tmp
*.FCStd1
*.FCBak
*.lck
*_backup*
.~lock.*

# Slicer output (export from the 3MF, do not commit machine code)
*.gcode
*.bgcode

# OS
.DS_Store
Thumbs.db
desktop.ini

# Python caches (macros)
__pycache__/
*.pyc

# FreeCAD assembly documents saved by the macros (SAVE_FCSTD): large, regenerate them
00 - Docs/*/CAD/
