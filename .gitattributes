# Native CAD files and print exports are binary: Git LFS.
# STEP, IGES and DXF are text and stay in plain Git (readable diffs).
*.sldprt    filter=lfs diff=lfs merge=lfs -text
*.SLDPRT    filter=lfs diff=lfs merge=lfs -text
*.sldasm    filter=lfs diff=lfs merge=lfs -text
*.SLDASM    filter=lfs diff=lfs merge=lfs -text
*.slddrw    filter=lfs diff=lfs merge=lfs -text
*.SLDDRW    filter=lfs diff=lfs merge=lfs -text
*.f3d       filter=lfs diff=lfs merge=lfs -text
*.f3z       filter=lfs diff=lfs merge=lfs -text
*.ipt       filter=lfs diff=lfs merge=lfs -text
*.iam       filter=lfs diff=lfs merge=lfs -text
*.FCStd     filter=lfs diff=lfs merge=lfs -text
*.3dm       filter=lfs diff=lfs merge=lfs -text
*.stl       filter=lfs diff=lfs merge=lfs -text
*.STL       filter=lfs diff=lfs merge=lfs -text
*.3mf       filter=lfs diff=lfs merge=lfs -text
*.blend     filter=lfs diff=lfs merge=lfs -text
*.glb       filter=lfs diff=lfs merge=lfs -text
*.obj       filter=lfs diff=lfs merge=lfs -text
*.png       filter=lfs diff=lfs merge=lfs -text
*.PNG       filter=lfs diff=lfs merge=lfs -text
*.jpg       filter=lfs diff=lfs merge=lfs -text
*.xlsx      filter=lfs diff=lfs merge=lfs -text
*.pdf       filter=lfs diff=lfs merge=lfs -text
*.zip       filter=lfs diff=lfs merge=lfs -text

# Text CAD formats: normal Git, never touched by line-ending conversion.
*.step      -text diff
*.stp       -text diff
*.STEP      -text diff
*.STP       -text diff
*.dxf       -text diff
*.DXF       -text diff

# Macros, data and docs: plain text, LF line endings
*.FCMacro   text eol=lf
*.py        text eol=lf
*.json      text eol=lf
*.csv       text eol=lf
*.md        text eol=lf
